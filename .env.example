# =========================================================
# 백엔드 환경변수 예시 파일
# 이 파일을 복사하여 backend/.env 로 저장한 뒤 값을 채워 넣으세요.
# API Key가 없는 항목은 비워두어도 서비스는 정상 동작하며,
# 해당 기능은 "Provider unavailable" 상태로 처리됩니다.
# =========================================================

# 실행 환경: development | production
APP_ENV=development

# 데이터베이스
# 개발: SQLite (기본값) / 운영: PostgreSQL 또는 Supabase Postgres 연결문자열 사용
DATABASE_URL=sqlite:///./stock_platform.db
# 운영 예시: postgresql+psycopg2://user:password@host:5432/dbname

# ---------------------------------------------------------
# 주가 데이터 Provider
# ---------------------------------------------------------
# 기본 Provider는 FinanceDataReader (API Key 불필요, KRX/네이버 금융 기반).
# 아래 Key가 설정되면 우선순위가 더 높은 공식 API로 전환할 수 있도록 Adapter가 준비되어 있습니다.
KRX_OPEN_API_KEY=
KOREA_INVESTMENT_APP_KEY=
KOREA_INVESTMENT_APP_SECRET=

# ---------------------------------------------------------
# 공시 데이터 (OpenDART)
# ---------------------------------------------------------
DART_API_KEY=

# ---------------------------------------------------------
# 거시경제 CPI (한국은행 ECOS) - 물가조정(명목->실질금액 환산)에 사용. ecos.bok.or.kr 에서 발급.
# Provider 연동 및 라이브 검증 완료(app/providers/macro_provider.py).
# ---------------------------------------------------------
ECOS_API_KEY=

# ---------------------------------------------------------
# 뉴스 데이터 - 1차 Provider (네이버 뉴스 검색 API, 필수 권장)
# 주의(2026-07-31 변경): 신규 발급은 더 이상 developers.naver.com(개발자센터)에서 안 됨 -
# 네이버클라우드플랫폼(ncloud.com)의 "NAVER API HUB"에서 Application을 새로 만들어야 함.
# 무료(한시적), 월 775,000회 / 키당 최대 초당 50회. 자세한 이유/절차는
# backend/app/providers/news_provider.py 모듈 docstring 참고.
# ---------------------------------------------------------
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ---------------------------------------------------------
# 뉴스 데이터 - 2차 Provider (NewsData.io, 1차 결과 부족 시 보완용, 선택)
# 무료: 하루 200 credits(1 credit = 기사 10건). newsdata.io 가입 후 대시보드에서 확인.
# ---------------------------------------------------------
NEWSDATA_API_KEY=

# ---------------------------------------------------------
# 뉴스 데이터 - 3차 Provider (GNews, 그래도 부족할 때만 보완용, 선택 - 키 없으면 자동 skip)
# 무료: 하루 100회, 요청당 최대 10건, 최신성 12시간 지연. gnews.io 가입 후 대시보드에서 확인.
# ---------------------------------------------------------
GNEWS_API_KEY=

# ---------------------------------------------------------
# 과거 뉴스 (BIGKinds) - 기본 뉴스 수집 파이프라인에서는 사용하지 않음(선택적/향후 기능용).
# 인증정보 없으면 자동으로 "provider unavailable" 처리
# ---------------------------------------------------------
BIGKINDS_API_KEY=

# ---------------------------------------------------------
# AI 질의응답 (Anthropic Claude API) - 종목 상세 페이지 AI QA 패널용. 뉴스 수집과는 별개 기능.
# console.anthropic.com 에서 발급.
# ---------------------------------------------------------
ANTHROPIC_API_KEY=

# ---------------------------------------------------------
# 뉴스 모니터링 (Background Polling)
# ---------------------------------------------------------
NEWS_POLLING_INTERVAL_SECONDS=300

# CORS 허용 Origin (콤마로 구분)
CORS_ORIGINS=http://localhost:3000
